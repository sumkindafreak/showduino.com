{
  "name": "showduino-studio-app",
  "version": "0.1.0",
  "private": true,
  "description": "Showduino Studio Windows and Android shell",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.cjs",
    "start:windows": "npm run prepare:web && electron .",
    "build:windows": "npm run prepare:web && electron-builder --win nsis",
    "android:init": "npm run prepare:web && npx cap add android",
    "android:sync": "npm run prepare:web && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.showduino.studio",
    "productName": "Showduino Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
